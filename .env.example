# Kopieer dit bestand naar .env en vul één blok in. Commit .env nooit.

# --- Blok 0: Claude-abonnement via de Claude Agent SDK (onze standaard) ---
# Vereist: de `claude` CLI is geïnstalleerd en ingelogd (`claude auth status`). Geen API-key nodig.
# Modellen: sonnet/opus/haiku (of een volledige model-ID). EFFORT: low|medium|high.
BACKEND=claude
MODEL_KLEIN=sonnet
MODEL_GROOT=opus
EFFORT_KLEIN=low
EFFORT_GROOT=medium

# --- Blok 1: Roboest-endpoint (back-up, OpenAI-compatibel) ---
# Je teamkey staat op het Teamkaartje. Eén key per team, $5 budget, geldig op 24/11 tot 18:00.
# BACKEND=openai
# OPENAI_BASE_URL=https://roboest.findingsolutions.be/v1
# OPENAI_API_KEY=<teamkey van je Teamkaartje>
# MODEL_KLEIN=achrona
# MODEL_GROOT=achrona-groot

# --- Blok 2: FreeLLMAPI op je eigen laptop (optioneel, gratis) ---
# BACKEND=openai
# OPENAI_BASE_URL=http://localhost:3001/v1
# OPENAI_API_KEY=<unified-key>
# MODEL_KLEIN=auto:fast
# MODEL_GROOT=auto:smartest

# --- Kennisbronnen: één MCP-pad per Raadslid (verplicht voor elke Rol in raadsleden/) ---
MCP_ARCHMAGE=https://mcp.findingsolutions.be/archmage/mcp
MCP_ENGINEER=https://mcp.findingsolutions.be/engineer/mcp
MCP_GUARDIAN_KEEPER=https://mcp.findingsolutions.be/guardian_keeper/mcp
MCP_HISTORIAN=https://mcp.findingsolutions.be/historian/mcp
MCP_ORACLE=https://mcp.findingsolutions.be/oracle/mcp
MCP_BEAST_MASTER=https://mcp.findingsolutions.be/beast_master/mcp

# Het Beurtenbudget (maximaal 10 Raadslid-beurten per run) staat vast in council.py.
